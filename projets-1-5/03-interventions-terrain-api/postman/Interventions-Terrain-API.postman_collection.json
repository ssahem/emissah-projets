{
  "info": {
    "_postman_id": "interventions-terrain-api-collection",
    "name": "Interventions terrain — API REST",
    "description": "Projet 3 de la formation. Aucune authentification : l'énoncé ne définit ni utilisateur ni rôle, donc ni jeton, ni identifiants, ni code 401/403. Importer cette collection, adapter les variables host/baseUrl si besoin, puis exécuter les POST de création dans l'ordre pour renseigner les identifiants. Le profil dev fournit les données de démo (RACCORDEMENT_FIBRE, MAT001, MAT002). F16 est planifiée sans route HTTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8083"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8083/interventions-terrain"
    },
    {
      "key": "idAgence",
      "value": "1"
    },
    {
      "key": "idTechnicien",
      "value": "1"
    },
    {
      "key": "idTechnicien2",
      "value": "2"
    },
    {
      "key": "idCompetence",
      "value": "1"
    },
    {
      "key": "idClient",
      "value": "1"
    },
    {
      "key": "idIntervention",
      "value": "1"
    },
    {
      "key": "codeType",
      "value": "RACCORDEMENT_FIBRE"
    },
    {
      "key": "mois",
      "value": "2026-11"
    }
  ],
  "item": [
    {
