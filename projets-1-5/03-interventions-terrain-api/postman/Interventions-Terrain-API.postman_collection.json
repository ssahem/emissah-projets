      "item": [
        {
          "name": "GET — Santé (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/actuator/health/readiness",
            "description": "Vérifie que l'API et la base sont prêtes."
          }
        },
        {
          "name": "GET — Document OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/v3/api-docs",
            "description": "Liste toutes les routes ; Swagger UI : /swagger-ui.html."
          }
        }
      ],
      "description": "Contrôles sans authentification."
    },
    {
