                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nom\": \"Agence Lyon Part-Dieu\",\n  \"ville\": \"Lyon\",\n  \"responsable\": \"Alexandre Dupont\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
