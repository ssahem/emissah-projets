          "name": "Agence (F1)",
          "item": [
            {
              "name": "POST — Créer une agence",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/agence/create",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nom\": \"Agence Lyon Part-Dieu\",\n  \"ville\": \"Lyon\",\n  \"adresse\": \"8 rue de la République\",\n  \"responsable\": \"Alexandre Dupont\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "201 + en-tête Location ; l'identifiant est mémorisé dans idAgence."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201 || pm.response.code === 200) {",
                      "  const corps = pm.response.json();",
                      "  if (corps && corps.idAgence !== undefined) {",
                      "    pm.collectionVariables.set(\"idAgence\", corps.idAgence);",
                      "  }",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "GET — Lister les agences",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/agence/list"
              }
            },
            {
              "name": "GET — Lire une agence",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/agence/get/{{idAgence}}"
              }
            },
            {
              "name": "PUT — Modifier une agence",
              "request": {
                "method": "PUT",
