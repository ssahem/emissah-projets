            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Koffi\",\n  \"prenom\": \"Yao\",\n  \"dateNaissance\": \"2011-03-02\",\n  \"idClasse\": {{idClasse}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
