        },
        {
          "name": "GET — Rechercher un élève (F9)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/eleve/list?nom={{nomEleve}}",
            "description": "200 : recherche partielle insensible à la casse sur le nom. Sans paramètre nom, renvoie la liste complète. 400 si la recherche est vide."
          }
        },
        {
          "name": "GET — Détail d'un élève (F2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/eleve/get/{{idEleve}}",
            "description": "200 ; 404 si l'élève est introuvable."
          }
        },
        {
          "name": "PUT — Modifier un élève (F2)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/eleve/update/{{idEleve}}",
            "description": "200 ; change nom, prénom et classe courante via une nouvelle inscription.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Koffi\",\n  \"prenom\": \"Yao\",\n  \"idClasse\": {{idClasse}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET — Notes d'un élève (F7)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/eleve/notes/{{idEleve}}?trimestre={{trimestre}}",
            "description": "200 : notes groupées par matière. Sans trimestre, toutes les notes sont renvoyées."
          }
        },
        {
          "name": "POST — Changer de classe (F11)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/eleve/affectation/{{idEleve}}",
            "description": "201 : clôture l'ancienne inscription et en ouvre une nouvelle. 409 si la classe destination est pleine ou de niveau différent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idClasseDestination\": {{idClasse}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET — Moyennes par matière (F17)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/eleve/moyennes/{{idEleve}}?trimestre={{trimestre}}",
            "description": "200 : une ligne par matière enseignée dans la classe, avec nombreNotes et evaluee. Les matières sans note ont une moyenne absente et evaluee=false."
          }
        },
        {
          "name": "GET — Moyenne générale (F18)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/eleve/moyenne-generale/{{idEleve}}?trimestre={{trimestre}}",
            "description": "200 : moyenne pondérée par les coefficients et détail contribution par contribution. Sans aucune note, moyenneGenerale est absente, jamais zéro."
          }
        },
        {
          "name": "DELETE — Supprimer un élève (F2)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/eleve/delete/{{idEleve}}",
            "description": "204 ; 409 si l'élève possède encore des notes."
          }
        }
      ]
    },
