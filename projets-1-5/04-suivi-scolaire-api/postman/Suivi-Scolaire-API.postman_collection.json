          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const corps = pm.response.json();",
                  "  if (corps && corps.idEleve !== undefined) {",
                  "    pm.collectionVariables.set(\"idEleve\", corps.idEleve);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET — Liste des élèves (F2)",
