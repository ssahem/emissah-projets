    {
      "name": "07 — Alertes de difficulté (F16, F18)",
      "description": "Consultation des alertes produites par la tâche planifiée hebdomadaire. La détection automatique n'a pas de route HTTP obligatoire (F16).",
      "item": [
        {
          "name": "GET — Alertes d'un trimestre (F16)",
          "request": {
            "method": "GET",
            "header": [],
