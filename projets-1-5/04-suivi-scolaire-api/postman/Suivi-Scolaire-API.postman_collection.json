{
  "info": {
    "_postman_id": "suivi-scolaire-api-collection",
    "name": "Suivi scolaire — API REST",
    "description": "Projet 4 de la formation. Aucune authentification : l'énoncé ne définit ni utilisateur ni rôle, donc ni jeton, ni identifiants, ni code 401/403. Importer cette collection, adapter les variables host/baseUrl si besoin, puis exécuter les POST de création dans l'ordre pour renseigner les identifiants. Le profil dev fournit les données de démo (classes 1 à 3, élèves 1 à 6, matières 1 à 4). Toutes les URL commencent par /suivi-scolaire/ et utilisent des ressources au singulier. F16 est détectée automatiquement chaque lundi ; la route /alerte/list permet de consulter le résultat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "00 — Socle",
      "description": "Contrôles sans authentification et documentation OpenAPI.",
      "item": [
        {
          "name": "GET — Santé (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{host}}/actuator/health/readiness",
            "description": "200 : l'API et PostgreSQL sont prêts. Aucune authentification requise : l'API est publique."
          }
        },
        {
          "name": "GET — Document OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{host}}/v3/api-docs",
            "description": "200 : liste toutes les routes ; Swagger UI sur /swagger-ui.html."
          }
        }
      ]
    },
    {
      "name": "01 — Classes (F1, F6, F8, F19)",
      "description": "CRUD des classes, effectif détaillé, notes par matière et classement. Le nom de classe est unique pour un niveau (V2).",
      "item": [
        {
          "name": "POST — Créer une classe (F1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/classe/create",
            "description": "201 + en-tête Location ; l'identifiant est mémorisé dans idClasse. 409 si le nom existe déjà pour ce niveau.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"4B\",\n  \"idAnnee\": 2,\n  \"idNiveau\": 1,\n  \"effectifMax\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const corps = pm.response.json();",
                  "  if (corps && corps.idClasse !== undefined) {",
                  "    pm.collectionVariables.set(\"idClasse\", corps.idClasse);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET — Liste des classes (F1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classe/list",
            "description": "200 : tableau de classes avec effectifActuel."
          }
        },
        {
          "name": "GET — Détail d'une classe (F1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classe/get/{{idClasse}}",
            "description": "200 ; 404 si la classe est introuvable."
          }
        },
        {
          "name": "PUT — Modifier l'effectif maximal (F1)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/classe/update/{{idClasse}}",
            "description": "200 ; l'effectif maximal ne peut pas être inférieur à l'effectif courant (409).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectifMax\": 32\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET — Élèves d'une classe (F6)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classe/eleves/{{idClasse}}",
            "description": "200 : effectifActuel, capacity et liste triée par nom ; 404 si la classe est absente."
          }
        },
        {
          "name": "GET — Notes d'une matière dans une classe (F8)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classe/notes/{{idClasse}}?matiere={{idMatiere}}&trimestre={{trimestre}}",
            "description": "200 : moyenneClasse et notes groupées par élève. 400 si la matière n'est pas enseignée dans la classe ; 409 si le trimestre est clôturé."
          }
        },
        {
          "name": "GET — Classement d'une classe (F19)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/classe/classement/{{idClasse}}?trimestre={{trimestre}}",
            "description": "200 : rangs densifiés, moyenne de classe, meilleure et plus faible moyenne. Les élèves sans note sont en fin de liste sans rang."
          }
        },
        {
          "name": "DELETE — Supprimer une classe (F1)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/classe/delete/{{idClasse}}",
            "description": "204 ; 409 si la classe contient encore des élèves."
          }
        }
      ]
    },
    {
      "name": "02 — Élèves (F2, F7, F9, F11, F17, F18)",
      "description": "CRUD, recherche partielle, notes, changement de classe et restitutions.",
