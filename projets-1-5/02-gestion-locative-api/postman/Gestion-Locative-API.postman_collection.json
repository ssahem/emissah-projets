{
  "info": {
    "_postman_id": "gestion-locative-api-collection",
    "name": "Gestion locative — API REST",
    "description": "Projet 2 de la formation. Aucune authentification : ni utilisateur ni rôle dans l’énoncé. Le profil dev fournit 2 propriétaires, 3 immeubles, 8 appartements, 5 locataires, 5 baux (dont 2 clôturés), 8 révisions de loyer, 4 quittances et un état des lieux de sortie. Exécuter les POST de création dans l’ordre pour renseigner les variables d’identifiants.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8082"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8082/gestion-locative"
    },
    {
      "key": "idProprietaire",
      "value": "1"
    },
    {
      "key": "idImmeuble",
      "value": "1"
    },
    {
      "key": "idAppartement",
      "value": "1"
    },
    {
      "key": "idLocataire",
      "value": "1"
    },
    {
      "key": "idBail",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "00 — Socle",
      "item": [
        {
          "name": "GET — Santé",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/actuator/health/readiness"
          }
        },
        {
          "name": "GET — Document OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/v3/api-docs"
          }
        }
      ],
      "description": "Aucune authentification. F16 (clôture nocturne) est une tâche planifiée sans route HTTP."
    },
    {
      "name": "Propriétaire (F1, F7)",
      "item": [
        {
          "name": "POST — Créer un propriétaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/proprietaire/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Collection\",\n  \"prenom\": \"Test\",\n  \"email\": \"collection.test@example.test\",\n  \"telephone\": \"0102030499\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 ; l’identifiant est mémorisé dans idProprietaire."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const corps = pm.response.json();",
                  "  if (corps && corps.idProprietaire !== undefined) { pm.collectionVariables.set(\"idProprietaire\", corps.idProprietaire); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET — Lister les propriétaires",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/proprietaire/list"
          }
        },
        {
          "name": "GET — Lire un propriétaire",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/proprietaire/get/{{idProprietaire}}"
          }
        },
        {
          "name": "F7 — Immeubles d’un propriétaire",
          "request": {
