            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/proprietaire/immeubles/{{idProprietaire}}",
            "body": {
              "mode": "raw",
              "raw": "Avec le propriétaire 1 de la démo : 2 immeubles, chacun avec son nombre d’appartements et de baux en cours.",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT — Modifier un propriétaire",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/proprietaire/update/{{idProprietaire}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Collection\",\n  \"prenom\": \"Test\",\n  \"email\": \"collection.test@example.test\",\n  \"telephone\": \"0102030498\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE — Supprimer un propriétaire",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/proprietaire/delete/{{idProprietaire}}",
            "body": {
              "mode": "raw",
              "raw": "204 ; refuse si des immeubles sont encore rattachés.",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
